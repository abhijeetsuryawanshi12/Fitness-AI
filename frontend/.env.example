# Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# Firebase Web App Configuration
# Get these from Firebase Console → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Web Push Notifications
# This should match VAPID_PUBLIC_KEY from backend .env
VITE_FIREBASE_VAPID_KEY="your-vapid-public-key-from-backend-env"

# Instructions:
# 1. Copy this file to .env
# 2. Create a Firebase project at https://console.firebase.google.com
# 3. Add a Web App to your Firebase project
# 4. Copy the config values from Firebase Console
# 5. Make sure VITE_FIREBASE_VAPID_KEY matches backend's VAPID_PUBLIC_KEY
# 6. Never commit .env to version control
